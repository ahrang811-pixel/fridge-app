VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Naver Clova OCR (서버 사이드 전용 - VITE_ 접두사를 붙이지 마세요)
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# Google Gemini API (서버 사이드 전용 - VITE_ 접두사를 붙이지 마세요)
GEMINI_API_KEY=

# YouTube Data API (서버 사이드 전용 - VITE_ 접두사를 붙이지 마세요)
YOUTUBE_API_KEY=

# 유통기한 임박 Web Push 알림
# VAPID 키는 `npx web-push generate-vapid-keys`로 직접 생성하세요.
# 공개키(VITE_VAPID_PUBLIC_KEY)는 클라이언트에서도 구독에 사용되므로 VITE_ 접두사가 필요합니다.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Supabase 서비스 롤 키 (서버 사이드 전용) - 크론 작업이 모든 사용자의 식재료/구독
# 정보를 RLS 우회로 조회하는 데 사용합니다. Supabase 대시보드 > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron이 /api/cron/check-expiry를 호출할 때 자동으로 실어 보내는 인증값.
# 여기에 넣은 값과 같은 이름(CRON_SECRET)의 환경 변수를 Vercel 프로젝트에도 설정하세요.
CRON_SECRET=
